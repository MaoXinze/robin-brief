# 知更 Robin 配置样例 —— 复制为 .env 并填入你的 Key：cp .env.example .env
# CLI 也提供 robin init 自动完成复制。

# ---------- LLM（OpenAI 兼容接口，默认 DeepSeek）----------
# DeepSeek: https://platform.deepseek.com 申请
ROBIN_LLM_API_KEY=sk-your-deepseek-api-key
ROBIN_LLM_BASE_URL=https://api.deepseek.com
ROBIN_LLM_MODEL=deepseek-chat

# 换供应商示例（任何 OpenAI 兼容端点均可）：
# ROBIN_LLM_BASE_URL=https://api.moonshot.cn/v1   ROBIN_LLM_MODEL=kimi-k2-0905-preview
# ROBIN_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ROBIN_LLM_MODEL=glm-4.6

# ---------- 飞书推送（可选，不填则跳过推送）----------
# 飞书群 -> 设置 -> 群机器人 -> 添加自定义机器人，取 Webhook 地址
ROBIN_FEISHU_WEBHOOK_URL=
ROBIN_FEISHU_SECRET=

# ---------- 运行参数（一般无需改动）----------
ROBIN_DB_PATH=data/robin.db
ROBIN_OUTPUT_DIR=output
ROBIN_MIN_ARTICLES=10
ROBIN_COLLECT_WINDOW_HOURS=30
ROBIN_RELAXED_WINDOW_HOURS=72
